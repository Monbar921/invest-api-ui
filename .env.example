# Адрес API для собранного UI. В dev не нужен: Vite проксирует /api, /oauth2, /login, /logout на invest-gateway.
# Gateway работает на session cookie, поэтому UI и API должны быть на одном origin
# VITE_API_URL=

# Номер счётчика Яндекс Метрики. Не задан - аналитики и баннера согласия нет
# VITE_YANDEX_METRIKA_ID=
